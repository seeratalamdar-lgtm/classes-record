const http = require('http');
const oracledb = require('oracledb');

const PORT = process.env.PORT || 3000;

const dbConfig = {
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  connectString: process.env.DB_CONNECT_STRING
};

oracledb.getConnection(dbConfig)
 .then(conn => {
   console.log('✅ Connected to Oracle database');
   return conn.close();
 })
 .catch(err => console.error('❌ Database connection failed:', err.message));

function json(res, code, data) {
  res.writeHead(code, {
    'Content-Type': 'application/json',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type'
  });
  res.end(JSON.stringify(data));
}

async function handleApi(method, pathname, req, res) {
  if (method === 'OPTIONS') {
    res.writeHead(200, {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type'
    });
    res.end();
    return;
  }

  let body = {};
  if (method === 'POST' || method === 'PUT' || method === 'PATCH') {
    const chunks = [];
    for await (const chunk of req) chunks.push(chunk);
    try {
      body = JSON.parse(Buffer.concat(chunks).toString());
    } catch(e) {}
  }

  let conn;
  try {
    conn = await oracledb.getConnection(dbConfig);

    if (method === "POST" && pathname === "/api/auth/register") {
      const { email, password, name } = body;
      if (!email || !password) return json(res, 400, { success: false, message: "Email and password required" });

      try {
        await conn.execute(`
          BEGIN
            EXECUTE IMMEDIATE 'CREATE TABLE users (
              id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
              email VARCHAR2(255) UNIQUE NOT NULL,
              password VARCHAR2(255) NOT NULL,
              name VARCHAR2(255),
              created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )';
          EXCEPTION
            WHEN OTHERS THEN
              IF SQLCODE != -955 THEN RAISE; END IF;
          END;
        `);

        const exists = await conn.execute(
          `SELECT id FROM users WHERE email = :email`,
          { email },
          { outFormat: oracledb.OUT_FORMAT_OBJECT }
        );

        if (exists.rows.length) {
          return json(res, 400, { success: false, message: "Email already exists" });
        }

        const result = await conn.execute(
          `INSERT INTO users (email, password, name) VALUES (:email, :password, :name) RETURNING id, email, name INTO :id, :email_out, :name_out`,
          {
            email,
            password,
            name,
            id: { dir: oracledb.BIND_OUT, type: oracledb.NUMBER },
            email_out: { dir: oracledb.BIND_OUT, type: oracledb.STRING },
            name_out: { dir: oracledb.BIND_OUT, type: oracledb.STRING }
          },
          { autoCommit: true }
        );

        json(res, 201, {
          success: true,
          user: {
            id: result.outBinds.id[0],
            email: result.outBinds.email_out[0],
            name: result.outBinds.name_out[0]
          }
        });
      } catch(e) {
        json(res, 500, { success: false, error: e.message });
      }
      return;
    }

    if (pathname === '/health' || pathname === '/ping') {
      json(res, 200, { status: 'ok', timestamp: new Date().toISOString() });
      return;
    }

    json(res, 404, { error: 'Not found' });

  } catch (e) {
    console.error('DB Error:', e);
    json(res, 500, { error: e.message });
  } finally {
    if (conn) {
      try { await conn.close(); } catch(e) {}
    }
  }
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host}`);
  try {
    await handleApi(req.method, url.pathname, req, res);
  } catch (e) {
    console.error('Server error:', e);
    json(res, 500, { error: 'Internal server error' });
  }
});

server.listen(PORT, () => {
  console.log(`🚀 Server running on port ${PORT}`);
});
